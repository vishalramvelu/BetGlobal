[Unit]
Description=BetGlobal Gunicorn application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=betglobal
Group=betglobal
WorkingDirectory=/opt/betglobal/current
EnvironmentFile=/etc/betglobal/betglobal.env
RuntimeDirectory=betglobal
RuntimeDirectoryMode=0750
UMask=0077
ExecStart=/opt/betglobal/venv/bin/gunicorn \
    --workers 1 \
    --threads 4 \
    --worker-class gthread \
    --bind 127.0.0.1:8000 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile - \
    app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/betglobal

[Install]
WantedBy=multi-user.target
