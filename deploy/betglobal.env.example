FLASK_ENV=production
BETGLOBAL_DATA_DIR=/var/lib/betglobal
BETGLOBAL_UPLOAD_DIR=/var/lib/betglobal/uploads/dispute_evidence
BETGLOBAL_DB_PATH=/var/lib/betglobal/betglobal.sqlite3
DATABASE_URL=sqlite:////var/lib/betglobal/betglobal.sqlite3
BETGLOBAL_BACKUP_DIR=/var/lib/betglobal/backups
BETGLOBAL_BACKUP_RETENTION_DAYS=14
ENABLE_SCHEDULER=true
MIGRATION_READ_ONLY=false
TESTING=false
MAIL_SUPPRESS_SEND=true
RATELIMIT_STORAGE_URI=memory://
SESSION_SECRET=replace-with-a-long-random-value
SECURITY_PASSWORD_SALT=replace-with-a-long-random-value
ADMIN_PASSWORD_HASH=replace-with-the-existing-production-hash
STRIPE_SECRET_KEY=replace-with-the-existing-production-value
STRIPE_PUBLISHABLE_KEY=replace-with-the-existing-production-value
STRIPE_ENDPOINT_SECRET=replace-with-the-existing-production-value
MAIL_SERVER=replace-with-the-existing-production-value
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=replace-with-the-existing-production-value
MAIL_PASSWORD=replace-with-the-existing-production-value
MAIL_DEFAULT_SENDER=noreply@betgloballive.com
